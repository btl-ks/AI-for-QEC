{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-for-qec.local/schemas/technology-catalog.schema.json",
  "title": "AI-for-QEC technology catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "phase", "decisions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "phase": { "type": "string" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "primary", "alternatives", "rationale"],
        "properties": {
          "component": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "primary": { "$ref": "#/$defs/technology" },
          "alternatives": {
            "type": "array",
            "items": { "$ref": "#/$defs/alternative" }
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "implementation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "version": { "type": "string" },
        "implementation": {
          "enum": ["none", "contracts-only", "partial", "implemented", "validated"]
        }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "implementation", "phase"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "version": { "type": "string" },
        "implementation": {
          "enum": ["none", "contracts-only", "partial", "implemented", "validated"]
        },
        "phase": { "type": "string" }
      }
    }
  }
}
